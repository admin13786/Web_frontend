# API 基地址。留空时排行榜/登录走 Vite 同源代理（→ localhost:8000，即 Crawl）。
# 若直接连后端（可能跨域）可写：VITE_API_BASE=http://localhost:8000
# VITE_API_BASE=

# OpenMAIC API 基地址（可为 http://localhost:3000 或同源代理 /openmaic）
# VITE_OPENMAIC_BASE_URL=http://localhost:3000
# VITE_OPENMAIC_BASE_URL=/openmaic
#
# 默认内嵌到当前访问域名的 3000 端口，可按部署修改。
# VITE_OPENMAIC_PORT=3000
#
# 如需直接指定完整地址，优先使用这个变量。
# VITE_OPENMAIC_APP_URL=http://localhost:3000

# EduRepo 视图模式：native（主站原生实现，默认）| embed（旧 iframe 回退模式）
# VITE_EDUREPO_VIEW_MODE=native
#
# 仅在 embed 模式下使用：EduRepo 页面地址
# VITE_EDUREPO_APP_URL=http://localhost:5188
# VITE_EDUREPO_APP_URL=/edurepo/

# 是否强制使用 Mock：true=始终 Mock，false=使用真实接口（需配置 VITE_API_BASE）
# VITE_USE_MOCK=true
# 视频榜 Mock（默认 true）；false 才请求 /api/ranks/.../video
# VITE_RANK_VIDEO_MOCK=true
# 微博/话题榜 Mock（默认 false=真实接口）；无后端时可设 true
# VITE_RANK_WEIBO_MOCK=false

# Docker / Nginx runtime upstreams
# FRONTEND_PORT=80
# NGINX_API_UPSTREAM_HOST=host.docker.internal
# NGINX_API_UPSTREAM_PORT=8000
# NGINX_WORKSHOP_UPSTREAM_HOST=host.docker.internal
# NGINX_WORKSHOP_UPSTREAM_PORT=5000
# NGINX_EDUREPO_APP_UPSTREAM_HOST=host.docker.internal
# NGINX_EDUREPO_APP_UPSTREAM_PORT=5188
# NGINX_EDUREPO_API_UPSTREAM_HOST=host.docker.internal
# NGINX_EDUREPO_API_UPSTREAM_PORT=9010

# Optional: override Android APK download link shown in the top-right action area
# VITE_ANDROID_APK_URL=/downloads/lingjing-android-latest.apk
