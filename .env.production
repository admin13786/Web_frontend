# 生产环境配置
# 使用 Nginx 反向代理，前端和 OpenMAIC 同源，无需处理 CORS

# OpenMAIC API 基地址 - 通过 Nginx 反向代理 /openmaic → localhost:3000
VITE_OPENMAIC_BASE_URL=/openmaic

# OpenMAIC 整页跳转地址 - 课堂生成后的访问地址
# 如果前端通过 80 端口访问，课堂页面也应该能通过 /openmaic 访问
# 如果希望独立访问课堂页面，可以设置为 http://服务器IP:3000
VITE_OPENMAIC_APP_URL=/openmaic

# API 基地址（通过 Nginx 反向代理）
VITE_API_BASE=

# 禁用 Mock 数据，使用真实后端接口
VITE_USE_MOCK=false
VITE_RANK_WEIBO_MOCK=false
